{
    "name": "axiomasoft/vaulter-sheets",
    "description": "Vaulter Sheets — spreadsheet document type and workbook engine integration for Vaulter.",
    "type": "library",
    "license": "proprietary",
    "homepage": "https://github.com/axiomasoft/vaulter-sheets",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "axiomasoft/packman": "^0.1",
        "axiomasoft/packman-plugins": "^0.1",
        "axiomasoft/vaulter-core": "^1.0",
        "axiomasoft/vaulter-documents": "^1.0",
        "axiomasoft/vaulter-drive": "^1.0",
        "axiomasoft/vaulter-media": "^1.0",
        "ext-mbstring": "*",
        "ext-zlib": "*",
        "illuminate/support": "^13.0",
        "php": ">=8.4 <8.6",
        "symfony/process": "^7.0 || ^8.0"
    },
    "require-dev": {
        "axiomasoft/vaulter-drive": "^1.0",
        "axiomasoft/vaulter-media": "^1.0",
        "larastan/larastan": "^3.15",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.2",
        "phpstan/phpstan": "^2.3.6"
    },
    "autoload": {
        "psr-4": {
            "Vaulter\\Sheets\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vaulter\\Sheets\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vaulter\\Sheets\\VaulterSheetsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
