{
  "name": "@vaulter/sheets-vue",
  "version": "1.0.0",
  "description": "Vue 3 spreadsheet viewer shell for Vaulter Sheets.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=26.13.1"
  },
  "type": "module",
  "vaulter": {
    "api": "1"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/vaulter-sheets-vue.umd.cjs",
  "module": "./dist/vaulter-sheets-vue.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vaulter-sheets-vue.js",
      "require": "./dist/vaulter-sheets-vue.umd.cjs"
    }
  },
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@vaulter/vue": "^1.0.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@vaulter/vue": "file:../../../vaulter/packages/vue",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.10.6",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.42",
    "vue-tsc": "^2.1.0"
  }
}
