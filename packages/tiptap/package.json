    "@tiptap/pm": "3.35.0",
    "@tiptap/starter-kit": "3.35.0",
    "@tiptap/vue-3": "3.35.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "happy-dom": "^20.10.6",
    "typescript": "^5.6.0",
