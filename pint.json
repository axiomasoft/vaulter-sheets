{
    "preset": "laravel",
    "exclude": [
        "build",
        "vendor"
    ],
    "rules": {
        "declare_strict_types": true,
        "final_class": false,
        "ordered_imports": {
            "sort_algorithm": "alpha",
            "imports_order": [
                "class",
                "function",
                "const"
            ]
        },
        "no_unused_imports": true,
        "phpdoc_align": {
            "align": "vertical"
        },
        "phpdoc_order": true,
        "phpdoc_scalar": true,
        "phpdoc_trim": true,
        "single_quote": true,
        "trailing_comma_in_multiline": {
            "elements": [
                "arrays",
                "arguments",
                "parameters",
                "match"
            ]
        },
        "not_operator_with_successor_space": false
    }
}
