{
    "name": "axiomasoft/vaulter-sheets-monorepo",
    "description": "Vaulter Sheets — zero-royalty spreadsheet engine (private monorepo workspace).",
    "type": "project",
    "license": "proprietary",
    "homepage": "https://github.com/axiomasoft/vaulter-sheets",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/axiomasoft/vaulter-sheets/issues",
        "source": "https://github.com/axiomasoft/vaulter-sheets"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/vaulter-sheets": "1.0.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../vaulter/packages/*",
            "exclude": ["axiomasoft/vaulter-collaboration"],
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/vaulter-core": "1.0.x-dev",
                    "axiomasoft/vaulter-drive": "1.0.x-dev",
                    "axiomasoft/vaulter-documents": "1.0.x-dev",
                    "axiomasoft/vaulter-media": "1.0.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../vaulter-collaboration/packages/collaboration",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/vaulter-collaboration": "1.0.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../packman/packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/packman": "0.1.1",
                    "axiomasoft/packman-devtools": "0.1.1",
                    "axiomasoft/packman-plugins": "0.1.1",
                    "axiomasoft/packman-schema": "0.1.1",
                    "axiomasoft/packman-testkit": "0.1.1"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.4 <8.6",
        "axiomasoft/vaulter-sheets": "^1.0"
    },
    "require-dev": {
        "axiomasoft/packman-devtools": "^0.1",
        "axiomasoft/vaulter-collaboration": "^1.0",
        "axiomasoft/vaulter-drive": "^1.0",
        "axiomasoft/vaulter-media": "^1.0",
        "larastan/larastan": "^3.15",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.2",
        "pestphp/pest-plugin-type-coverage": "^5.1",
        "phpstan/phpstan": "~2.3.7",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "rector/rector": "~2.8.5",
        "spaze/phpstan-disallowed-calls": "^4.15.1"
    },
    "autoload-dev": {
        "psr-4": {
            "Vaulter\\Sheets\\Tests\\": "packages/sheets/tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "lint": "@php vendor/bin/pint",
        "lint:check": "@php vendor/bin/pint --test",
        "analyse": "@php vendor/bin/phpstan analyse -c phpstan.neon.dist --memory-limit=1G --no-progress",
        "phpstan": "@analyse",
        "refactor": "@php vendor/bin/rector process",
        "refactor:check": "@php vendor/bin/rector process --dry-run",
        "node:deps": "bash scripts/node-deps.sh",
        "test": [
            "@node:deps",
            "@php vendor/bin/pest -c packages/sheets/phpunit.xml --test-directory=packages/sheets/tests"
        ],
        "test:types": "@php -d memory_limit=1G vendor/bin/pest -c packages/sheets/phpunit.xml --test-directory=packages/sheets/tests --type-coverage --min=100"
    }
}
