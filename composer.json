{
    "name": "axiomasoft/vaulter-sheets-monorepo",
    "description": "Vaulter Sheets — zero-royalty spreadsheet engine (private monorepo workspace).",
    "type": "project",
    "license": "proprietary",
    "homepage": "https://github.com/axiomasoft/vaulter-sheets",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/axiomasoft/vaulter-sheets/issues",
        "source": "https://github.com/axiomasoft/vaulter-sheets"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/vaulter-sheets": "1.0.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../vaulter/packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/vaulter-core": "1.0.x-dev",
                    "axiomasoft/vaulter-drive": "1.0.x-dev",
                    "axiomasoft/vaulter-documents": "1.0.x-dev",
                    "axiomasoft/vaulter-media": "1.0.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../packman/packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/packman": "0.1.1",
                    "axiomasoft/packman-plugins": "0.1.1",
                    "axiomasoft/packman-schema": "0.1.1",
                    "axiomasoft/packman-testkit": "0.1.1"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.4 <8.6",
        "axiomasoft/vaulter-sheets": "@dev"
    },
    "require-dev": {
        "axiomasoft/vaulter-drive": "^1.0",
        "axiomasoft/vaulter-media": "^1.0",
        "larastan/larastan": "^3.15",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.2",
        "phpstan/phpstan": "^2.3.6"
    },
    "autoload-dev": {
        "psr-4": {
            "Vaulter\\Sheets\\Tests\\": "packages/sheets/tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest -c packages/sheets/phpunit.xml --test-directory=packages/sheets/tests",
        "phpstan": "@php vendor/bin/phpstan analyse -c phpstan.neon.dist --no-progress"
    }
}
