# Root scaffold. Package trees arrive in later waves; until then there is no PHP under this root.
# Vendor extensions are intentionally not included: nothing is installed yet.

parameters:
    level: max
    tmpDir: build/phpstan
    paths:
        - .
    excludePaths:
        - vendor/*
        - node_modules/*
        - .github/*
        - release/*
    inferPrivatePropertyTypeFromConstructor: true
